<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>MacPhone connects to Bluetooth LE devices so it can mirror them into the Android emulator.</string>
	<key>SUFeedURL</key>
	<string>https://github.com/jx-grxf/MacPhone/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>$(MACPHONE_SPARKLE_PUBLIC_KEY)</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
</dict>
</plist>
